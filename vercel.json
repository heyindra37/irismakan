{
  "cleanUrls": true,
  "headers": [
    { "source": "/books/:book/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/books/:book/assets/:file*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
